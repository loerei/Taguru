{
  "manifest_version": 3,
  "name": "Taguru",
  "version": "1.0.4",
  "description": "Minimalist Tab Sorter and Saved Tab Groups Manager",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Taguru",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open Taguru (Popup or Side Panel based on settings)"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  }
}
